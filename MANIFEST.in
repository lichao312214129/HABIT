# Include C sources for supervoxel texture matrix extension in sdists.
recursive-include habit/core/habitat_analysis/clustering_features/supervoxel_cext/src *.c
recursive-include habit/core/habitat_analysis/clustering_features/supervoxel_cext/src *.h

# Next-generation web GUI (API bridge, presets, built frontend).
recursive-include habit-gui/bridge *.py
recursive-include habit-gui/api *.py
recursive-include habit-gui/presets *.yaml
recursive-include habit-gui/web/dist *
prune habit-gui/web/node_modules
