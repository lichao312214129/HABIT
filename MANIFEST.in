# Apache-2.0 requires the license and the NOTICE attributions to travel with
# every redistribution, so they must be present in source distributions too.
include LICENSE
include NOTICE
include CITATION.cff
include README.md
include README_en.md
include pyproject.toml
include setup.py

# Include C sources for supervoxel texture matrix extension in sdists.
recursive-include habit/kernels/radiomics/cext/src *.c
recursive-include habit/kernels/radiomics/cext/src *.h

# Bundled PyRadiomics parameter presets (default params_file fallbacks).
recursive-include habit/resources/radiomics *.yaml

# Canonical demo YAML (single source of truth). setup.py sdist/build_py syncs
# this tree into habit/resources/demo_config/ for the installable package.
# Never include demo_data/.
recursive-include config *.yaml
recursive-include config *.yml
recursive-include config *.md
include scripts/sync_demo_config.py
include habit/resources/demo_config/__init__.py
# Build-generated mirror (populated by setup.py before sdist/wheel).
recursive-include habit/resources/demo_config *

# PEP 561 marker for users of static type checkers.
include habit/py.typed

# Keep published sdists lean: never ship the developer test suite or local
# build / demo artefacts (they are not part of the installable package).
prune tests
prune demo_data
prune docs
prune developer
prune .github
prune build
prune dist
