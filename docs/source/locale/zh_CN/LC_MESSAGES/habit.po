msgid "``*_per_habitat_volume`` :math:`= x/V_k`"
msgstr "``*_per_habitat_volume`` :math:`= x/V_k`"
#: ../../source/reference/features/graph.rst:772
msgid "``single_h{k}_avg_node_voxels``, ``*_std_node_voxels``"
msgstr "``single_h{k}_avg_node_voxels`` 、 ``*_std_node_voxels``"
#: ../../source/reference/features/graph.rst:773
msgid "``*_fraction`` :math:`= x/V_k`"
msgstr "``*_fraction`` :math:`= x/V_k` （占该生境体素比例）"
#: ../../source/reference/features/graph.rst:774
msgid "``single_h{k}_avg_edge_distance``, ``*_std_edge_distance``, ``*_spatial_dispersion``"
