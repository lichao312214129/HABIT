msgid "``pair_h{a}_h{b}_avg_edge_distance``, ``*_std_edge_distance``"
msgstr "``pair_h{a}_h{b}_avg_edge_distance`` 、 ``*_std_edge_distance``"
#: ../../source/reference/features/graph.rst:779
msgid "``*_per_pair_bbox_diagonal`` :math:`=x/\\delta_{ab}`, where :math:`\\delta_{ab}` is the bounding-box diagonal of :math:`L\\in\\{a,b\\}`"
msgstr "``*_per_pair_bbox_diagonal`` :math:`=x/delta_{ab}` ， :math:`delta_{ab}` 为 :math:`Lin{a,b}` 的包围盒对角线"
#: ../../source/reference/features/graph.rst:782
msgid "``pair_h{a}_h{b}_contact_voxels_sum``"
msgstr ""
