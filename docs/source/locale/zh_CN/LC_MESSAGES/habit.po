msgid ":py:obj:`ConcatCombiner <habit.combiners.ConcatCombiner>`"
msgstr ":py:obj:`ConcatCombiner <habit.combiners.ConcatCombiner>`"
#: ../../source/api/combiners.rst:33:<autosummary>:1
msgid "Merge sibling blocks by placing their columns side by side."
msgstr "通过将兄弟块的列并排放置来合并它们。"
#: ../../source/api/combiners.rst:33:<autosummary>:1
msgid ":py:obj:`WeightedConcatCombiner <habit.combiners.WeightedConcatCombiner>`"
msgstr ""
":py:obj:`WeightedConcatCombiner <habit.combiners.WeightedConcatCombiner>`"
#: ../../source/api/combiners.rst:33:<autosummary>:1
msgid "Concatenate sibling blocks after scaling each by a child-specific weight."
msgstr "按子节点特定权重缩放后拼接同级块。"
#: ../../source/api/combiners.rst:33:<autosummary>:1
msgid ":py:obj:`AverageCombiner <habit.combiners.AverageCombiner>`"
msgstr ":py:obj:`AverageCombiner <habit.combiners.AverageCombiner>`"
#: ../../source/api/combiners.rst:33:<autosummary>:1
msgid "Average sibling blocks element-wise, optionally with child weights."
msgstr "对同级块逐元素求平均，可选子块权重。"
#: ../../source/api/combiners.rst:33:<autosummary>:1
msgid ":py:obj:`RatioCombiner <habit.combiners.RatioCombiner>`"
msgstr ":py:obj:`RatioCombiner <habit.combiners.RatioCombiner>`"
#: ../../source/api/combiners.rst:33:<autosummary>:1
msgid "Element-wise ratio of two sibling blocks: ``first / (second + eps)``."
msgstr "两个同级块按元素求比： ``first / (second + eps)`` 。"
