msgstr "``visualization_show_background`` (``true``)"
#: ../../source/configuration/feature_extraction.rst:150
msgid "``visualization_show_grid`` (``true``)"
msgstr "``visualization_show_grid`` （ ``true`` ）"
#: ../../source/configuration/feature_extraction.rst:151
msgid "``visualization_block_size`` (``null`` → extraction ``block_size``, default 8 voxels)"
msgstr "``visualization_block_size`` （ ``null`` → 提取 ``block_size`` ，默认 8 体素）"
#: ../../source/configuration/feature_extraction.rst:152
msgid "``visualization_grid_linestyle`` (``--`` dashed)"
