#: ../../source/configuration/habitat.rst:737
#: ../../source/configuration/habitat.rst:823
#: ../../source/configuration/habitat.rst:1180
msgid "**Default**: ``2``"
msgstr "**默认** ： ``2``"
#: ../../source/configuration/habitat.rst:738
msgid "**Description**: Lower bound for automatic selection"
msgstr "**Description** ：自动选择下界"
#: ../../source/configuration/habitat.rst:740
msgid "``max_clusters``: Maximum cluster count"
msgstr "``max_clusters`` ：最大簇数"
#: ../../source/configuration/habitat.rst:744
msgid "**Description**: Upper bound for automatic selection"
msgstr "**描述** ：自动选择的上限"
