msgid "``firstorder_{i}_and_{j}`` (i < j, or i = j ≥ 1)"
msgstr "``firstorder_{i}_and_{j}`` （i < j，或 i = j ≥ 1）"
#: ../../source/reference/features/msi.rst:67
msgid "Raw MSI matrix entry :math:`M_{ij}` (diagonal i≥1: connected subregion size; off-diagonal: inter-subregion border size). ``firstorder_0_and_0`` is not exported."
msgstr ""
"原始 MSI 矩阵元 :math:`M_{ij}` （对角 i≥1：连通子区域大小；非对角：子区域间边界大小）。不导出 ``firstorder_0_and_0`` 。"
#: ../../source/reference/features/msi.rst:68
msgid "``firstorder_normalized_{i}_and_{j}`` (same index rule)"
msgstr "``firstorder_normalized_{i}_and_{j}`` （相同索引规则）"
#: ../../source/reference/features/msi.rst:69
msgid "Normalized MSI matrix entry :math:`P_{ij}`. ``firstorder_normalized_0_and_0`` is not exported."
msgstr "归一化 MSI 矩阵元 :math:`P_{ij}` 。不导出 ``firstorder_normalized_0_and_0`` 。"
#: ../../source/reference/features/msi.rst:70
msgid "``contrast``, ``homogeneity``, ``energy``, ``correlation``"
msgstr "``contrast`` 、 ``homogeneity`` 、 ``energy`` 、 ``correlation``"
#: ../../source/reference/features/msi.rst:71
msgid "Four second-order statistical features on :math:`P` (Wu et al., Fig. 2c)"
